{
  "name": "whiterabbit",
  "version": "0.2.0",
  "private": true,
  "description": "Light-only synthetic foundation for accountable public-sector sensing",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.18.0 <27",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "dev:mobile": "corepack pnpm --filter @whiterabbit/mobile start",
    "dev:web": "corepack pnpm --filter @whiterabbit/web dev",
    "format": "prettier --write package.json pnpm-workspace.yaml tsconfig.base.json apps packages",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.base.json apps packages",
    "lint": "corepack pnpm -r --if-present lint",
    "test": "corepack pnpm -r --if-present test",
    "typecheck": "corepack pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
